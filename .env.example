# 生产环境必须自行生成，至少 32 字节；不要提交真实值。
REVGUARD_APPROVAL_SIGNING_KEY=replace-with-a-random-secret-at-least-32-bytes

# JSON: API key -> 服务端可信 actor/roles/scopes。示例仅展示结构。
REVGUARD_API_KEYS_JSON={"replace-operator-key":{"actor":"api-operator","roles":["viewer","operator"],"scopes":[]}}

# true 仅用于本地评测：启用 README 中公开的演示 API keys。
REVGUARD_ALLOW_INSECURE_DEMO_KEYS=false

# true 时容器启动会清空全部 Demo 状态并重新 seed，保证评委一键复现。
REVGUARD_RESET_ON_START=false

# 故障演练专用；非零只偏移 Verifier 首次读取，取证完成后恢复 0。
REVGUARD_VERIFICATION_TAMPER_AMOUNT=0
