# 生产环境必须自行生成，至少 32 字节；不要提交真实值。
REVGUARD_APPROVAL_SIGNING_KEY=replace-with-a-random-secret-at-least-32-bytes

# JSON: API key -> 服务端可信 actor/roles/scopes。示例仅展示结构。
REVGUARD_API_KEYS_JSON={"replace-operator-key":{"actor":"api-operator","roles":["viewer","operator"],"scopes":[]},"replace-orchestrator-key":{"actor":"revguard-orchestrator","roles":["viewer","dispatcher"],"scopes":[]}}

# true 仅用于本地评测：启用 README 中公开的演示 API keys。
REVGUARD_ALLOW_INSECURE_DEMO_KEYS=false

# 仅复放 2026-08-10 的旧 /tools/call 证据链时设为 true；新版 Agent 只调用 Skill。
REVGUARD_ENABLE_LEGACY_TOOL_API=false

# true 时容器启动会清空全部 Demo 状态并重新 seed，保证评委一键复现。
REVGUARD_RESET_ON_START=false

# 故障演练专用；非零只偏移 Verifier 首次读取，取证完成后恢复 0。
REVGUARD_VERIFICATION_TAMPER_AMOUNT=0

# 正式环境：写入及强一致读连主库端点；Trace/评测/列表可连只读端点。
# 不配置 REVGUARD_DATABASE_URL 时才使用本地 SQLite Demo Store。
REVGUARD_DATABASE_URL=postgresql://revguard_app:replace-password@primary-endpoint:5432/revguard?sslmode=verify-full
REVGUARD_READ_DATABASE_URL=postgresql://revguard_read:replace-password@readonly-endpoint:5432/revguard?sslmode=verify-full
REVGUARD_DB_POOL_MIN=1
REVGUARD_DB_POOL_MAX=10
# 生产保持 false；使用独立迁移账号运行 scripts/migrate_polardb.py。
REVGUARD_AUTO_MIGRATE=false
