# RevGuard 环境配置示例
# 复制为 .env 后按需修改

# 数据存储（默认本地 SQLite，复赛可替换为 PostgreSQL/PolarDB）
REVGUARD_DB_PATH=./data/revguard.db

# Mock 数据目录
REVGUARD_FIXTURES_DIR=./data/fixtures

# 运行产物输出目录（Trace / 案例记忆 / 审计报告）
REVGUARD_OUTPUT_DIR=./data/outputs
REVGUARD_REPORT_DIR=./docs/reports

# Mock 财务系统瞬时故障注入次数（演示工具重试用，0=关闭）
REVGUARD_FINANCE_FAIL_TIMES=1

# 审批模式：auto=演示时由模拟审批人自动审批；wait=等待人工通过 API 审批
REVGUARD_APPROVAL_MODE=auto

# AgentTeams 集成（Worker 回调本服务时使用）
REVGUARD_API_BASE=http://localhost:9000
