        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"revguard\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "未采集"
        },
        "overrides": []
      }
    },
    {
