    {
      "id": 7,
      "title": "API 请求速率 · 按响应类别",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(revguard_http_request_duration_seconds_count{route=~\"/api/v1/.*\"}[5m]))",
          "legendFormat": "{{status_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "无近期数据",
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "业务 API 响应延迟 · P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(revguard_http_request_duration_seconds_bucket{route=~\"/api/v1/(cases|skills|agent-tasks).*\"}[5m])))",
          "legendFormat": "业务 API P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "无近期数据",
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
