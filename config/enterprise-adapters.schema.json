{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ld0574.github.io/revguard/schemas/enterprise-adapters.schema.json",
  "title": "RevGuard Enterprise Adapter Configuration",
  "type": "object",
  "required": ["provider", "base_url", "authentication"],
  "properties": {
    "provider": {
      "enum": ["erpnext", "kingdee-k3cloud", "yonyou-bip", "sap-s4hana"]
    },
    "validation_status": {
      "enum": ["VALIDATED", "NOT_VALIDATED"]
    },
    "base_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "tenant_id": {"type": "string"},
    "account_set_id": {"type": "string"},
    "authentication": {
      "type": "object",
      "required": ["type", "secret_file"],
      "properties": {
        "type": {"enum": ["token", "oauth2-client-credentials", "session"]},
        "client_id": {"type": "string"},
        "secret_file": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "page_size": {"type": "integer", "minimum": 1, "maximum": 500},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
    "rate_limit_per_second": {"type": "number", "exclusiveMinimum": 0},
    "object_mapping": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "additionalProperties": false
}
