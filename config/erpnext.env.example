# Copy to .runtime/erpnext/erpnext.env on the deployment host and chmod 600.
# Generate strong values; never commit the populated file.
ERPNEXT_SITE_NAME=revguard.local
ERPNEXT_DB_ROOT_PASSWORD=replace-with-random-secret
ERPNEXT_ADMIN_PASSWORD=replace-with-random-secret
ERPNEXT_BIND_ADDRESS=127.0.0.1
ERPNEXT_PORT=18080
